<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(TargetFramework)'== 'net48'">
		<PackageReference Include="DynamoVisualProgramming.Core" Version="2.19.*" />
		<PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="2.19.*" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(TargetFramework)'== 'net8.0-windows'">
		<PackageReference Include="DynamoVisualProgramming.Core" Version="3.6.*" />
		<PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="3.6.*" />
	</ItemGroup>
	
	
	<ItemGroup>
		<ProjectReference Include="..\BIMformative.Core\BIMformative.Core.csproj" />
	</ItemGroup>
	
</Project>
