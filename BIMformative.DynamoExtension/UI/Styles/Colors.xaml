<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="ForegroundColor">#0F0D0B</Color>

    <!-- Primary -->
    <Color x:Key="PrimaryColor">#F97316</Color>
    <Color x:Key="PrimaryForegroundColor">#FAFAF7</Color>

    <!-- Secondary / Muted -->
    <Color x:Key="SecondaryColor">#F5F5F0</Color>
    <Color x:Key="SecondaryForegroundColor">#1C1917</Color>
    <Color x:Key="MutedForegroundColor">#B0B0B0</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- Destructive -->
    <Color x:Key="DestructiveColor">#EF4444</Color>

    <Color x:Key="ControlsBackground">#800C0A09</Color>

</ResourceDictionary>
