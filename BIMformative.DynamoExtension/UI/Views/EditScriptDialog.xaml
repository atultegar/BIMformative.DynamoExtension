<Window x:Class="BIMformative.DynamoExtension.UI.Views.EditScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
        xmlns:converters="clr-namespace:BIMformative.DynamoExtension.UI.Converters"
        mc:Ignorable="d"
        Title="Edit Script" 
        Width="1000" 
        Height="700"        
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/BIMformative.DynamoExtension;component/UI/Assets/bimformative-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/CheckBox.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/TextBox.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/RadioButton.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ScrollBar.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/DataGrid.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#EEEEEE" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!--ROOT-->
    <Grid Background="#292524">
        <Grid.Resources>
            <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        </Grid.Resources>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!--SIDEBAR-->
        <Border Grid.Column="0"
                Background="#1C1917"
                Padding="10">
            <StackPanel>

                <TextBlock Text="Edit Script"
                           Style="{StaticResource LabelStyle}"
                           FontSize="16"
                           Margin="10"/>

                <Button x:Name="MetadataButton"
                        Content="Metadata"
                        Style="{StaticResource ButtonOutline}"
                        BorderThickness="0"
                        Foreground="#EEEEEE"
                        Margin="0,6"
                        Click="ScrollToMetadata"/>

                <Button x:Name="TagsButton" 
                        Content="Tags"
                        Style="{StaticResource ButtonOutline}"
                        Foreground="#EEEEEE"
                        BorderThickness="0"
                        Margin="0,6"
                        Click="ScrollToTags"/>

                <Button x:Name="VisibilityButton" 
                        Content="Visibility"
                        Style="{StaticResource ButtonOutline}"
                        Foreground="#EEEEEE"
                        BorderThickness="0"
                        Margin="0,6"
                        Click="ScrollToVisibility"/>

                <Button x:Name="VersionsButton" 
                        Content="Versions"
                        Style="{StaticResource ButtonOutline}"
                        Foreground="#EEEEEE"
                        BorderThickness="0"
                        Margin="0,6"
                        Click="ScrollToVersions"/>

            </StackPanel>
        </Border>


        <!--EDITOR-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="EditorScrollViewer"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="EditorScrollViewer_ScrollChanged">

                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StylishScrollBar}"/>
                </ScrollViewer.Resources>

                <StackPanel Margin="20">

                    <!--METADATA SECTION-->
                    <StackPanel x:Name="MetadataSection">

                        <TextBlock Text="Title"
                               Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding EditTitle, 
                                    Mode=TwoWay, 
                                    UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}"/>

                        <TextBlock Text="Description"
                               Style="{StaticResource LabelStyle}"/>

                        <TextBox Text="{Binding EditDescription}"
                             Style="{StaticResource TextBoxStyle}"
                             AcceptsReturn="True"
                             Height="80"/>

                        <TextBlock Text="Script Type"
                               Style="{StaticResource LabelStyle}"/>


                        <ComboBox ItemsSource="{Binding ScriptTypes}"
                                  SelectedItem="{Binding EditScriptType, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Height="40">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                    </StackPanel>

                    <!--TAGS SECTION-->
                    <StackPanel x:Name="TagsSection"
                            Margin="0,40,0,0">

                        <TextBlock Text="Tags"
                               Style="{StaticResource LabelStyle}"/>
                        <Border Background="#0C0A09"                            
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6"
                            Height="40"
                            Margin="0,5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#7eb4ea"/>
                                            <Setter Property="Cursor" Value="IBeam"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="False">
                                            <Setter Property="BorderBrush" Value="#444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel VerticalAlignment="Center">

                                <!--Existing Tags-->
                                <ItemsControl ItemsSource="{Binding EditTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4"
                                                Background="#292524"
                                                Padding="8,4"
                                                Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryForegroundBrush}" 
                                                           FontSize="12"
                                                           FontWeight="Medium"/>
                                                    <Button Content="✕"
                                                        Cursor="Hand"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Width="16"
                                                        Height="16"
                                                        FontSize="10"
                                                        Command="{Binding DataContext.RemoveTagCommand, 
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{StaticResource PrimaryForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--Input Box-->
                                <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120"
                                         Foreground="#EEEEEE"
                                         Background="#0C0A09"
                                         BorderThickness="0"
                                         Cursor="IBeam"
                                         VerticalAlignment="Center"
                                         KeyDown="TagInput_KeyDown"/>
                            </WrapPanel>
                        </Border>

                    </StackPanel>

                    <!--VISIBILITY-->
                    <StackPanel x:Name="VisibilitySection"
                            Margin="0,40,0,0">

                        <TextBlock Text="Visibility"
                               Style="{StaticResource LabelStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                            <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                  IsChecked="{Binding IsPublic, 
                                                Mode=TwoWay, 
                                                UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Public"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!--VERSIONS-->
                    <StackPanel x:Name="VersionsSection"
                            Margin="0,40,0,0">

                        <DockPanel Margin="0,0,0,10">

                            <TextBlock Text="Versions"
                                   Style="{StaticResource LabelStyle}"
                                   DockPanel.Dock="Left"/>

                            <Button Content="Upload Version"
                                    Style="{StaticResource IconButtonStyle}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Margin="10,0,0,0"
                                    Width="125"
                                    Command="{Binding UploadVersionCommand}"
                                    Background="{StaticResource BackgroundBrush}"/>

                            <Button Content="Compare Versions"
                                    Style="{StaticResource IconButtonStyle}"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Margin="10,0,0,0"
                                    Width="125"
                                    Background="{StaticResource MutedForegroundBrush}"/>
                            
                        </DockPanel>

                        <DataGrid x:Name="VersionsGrid" 
                                  Grid.Row="1"
                                  ItemsSource="{Binding Versions}"
                                  Style="{StaticResource ShadcnDataGrid}"
                                  SelectionChanged="VersionsGrid_SelectionChanged"
                                  ColumnHeaderStyle="{StaticResource ShadcnDataGridColumnHeader}"
                                  CellStyle="{StaticResource ShadcnDataGridCell}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource ShadcnDataGridRow}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header=""
                                                        Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="Version"
                                                Binding="{Binding VersionNumber}"
                                                Width="80"/>

                                <DataGridTextColumn Header="Change Log"
                                                Binding="{Binding ChangeLog}"
                                                Width="*"/>

                                <DataGridTextColumn Header="Updated"
                                                Binding="{Binding UpdatedAt}"
                                                Width="90"/>

                                <DataGridTemplateColumn Header="Current"
                                                    Width="50">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding IsCurrent}"
                                                   Foreground="#22C55E"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Actions"
                                                    Width="200">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                                <Button Content="Set Current"
                                                        Style="{StaticResource ButtonGhost}"
                                                        IsEnabled="{Binding SetCurrentEnabled}"
                                                        Margin="2,5"
                                                        Command="{Binding SetCurrentCommand}"/>

                                                <Button Content="Delete"
                                                        Style="{StaticResource ButtonDestructive}"
                                                        Margin="2,5"
                                                        Command="{Binding DeleteVersionCommand}"/>
                                            </StackPanel>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>                    
                </StackPanel>

            </ScrollViewer>

            <Border Grid.Row="1"
                    Background="#1C1917">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Save"
                            Style="{StaticResource ButtonDefaultShadcn}"
                            Width="120"
                            Command="{Binding SaveMetadataCommand}"
                            Height="25"
                            Margin="10,5"/>

                    <Button Grid.Row="2"
                            Content="Close"
                            Style="{StaticResource ButtonSecondary}"
                            Width="120"
                            Height="25"
                            HorizontalAlignment="Right"
                            Margin="10,5"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>

            </Border>            
        </Grid>
    </Grid>
</Window>
