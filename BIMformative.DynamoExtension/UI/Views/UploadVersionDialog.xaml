<Window x:Class="BIMformative.DynamoExtension.UI.Views.UploadVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
        xmlns:converters="clr-namespace:BIMformative.DynamoExtension.UI.Converters"
        mc:Ignorable="d"
        Title="Upload Version"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#292524"
        Icon="/BIMformative.DynamoExtension;component/UI/Assets/bimformative-icon.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/TextBox.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/RadioButton.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#EEEEEE" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!--HEADER-->
        <TextBlock Text="Upload New Version"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#FAFAF9"/>
        
        <!--SOURCE-->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Source" Style="{StaticResource LabelStyle}"/>

            <StackPanel Orientation="Horizontal">
                <RadioButton Content="File"
                             GroupName="Source"
                             Style="{StaticResource RadioButtonStyle}"
                             IsChecked="{Binding UseFile, Mode=TwoWay}"
                             Margin="0,0,20,0"/>
                <RadioButton Content="Current Workspace"
                             GroupName="Source"
                             Style="{StaticResource RadioButtonStyle}"
                             IsChecked="{Binding UseWorkspace, Mode=TwoWay}"
                             Margin="0,0,20,0"/>
            </StackPanel>

            <Border BorderBrush="#C7C7C7" BorderThickness="0,0,0,1" Margin="0,10,0,0"/>
        </StackPanel>
        
        <!--FILE PICKER-->
        <StackPanel Grid.Row="2"
                    Opacity="{Binding UseFile, Converter={StaticResource BoolToOpacityConverter}}">

            <TextBlock Text="File" Style="{StaticResource LabelStyle}"/>

            <DockPanel>
                <Button Content="Browse"
                        Width="100"
                        Height="25"
                        Style="{StaticResource ButtonSecondary}"
                        Command="{Binding BrowseFileCommand}"
                        IsEnabled="{Binding UseFile}"
                        DockPanel.Dock="Right"/>

                <TextBox Text="{Binding FilePath}"
                         Style="{StaticResource TextBoxStyle}"
                         IsReadOnly="True"
                         Margin="0,0,8,0"/>

            </DockPanel>
        </StackPanel>
        
        <!--CHANGE LOG-->
        <StackPanel Grid.Row="3">

            <TextBlock Text="Change Log" Style="{StaticResource LabelStyle}"/>

            <TextBox Text="{Binding ChangeLog, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}"
                     AcceptsReturn="True"
                     Height="100"/>
        </StackPanel>
        
        <!--FOOTER-->
        <StackPanel Grid.Row="4"
                    Orientation="Vertical"
                    Margin="0,10,0,0">
            
            <!--STATUS MESSAGE-->
            <Border Background="#1C1917"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,10"
                    BorderBrush="{Binding StatusColor, FallbackValue=Green}"
                    BorderThickness="1"
                    Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TextBlock Text="{Binding StatusMessage, FallbackValue=SampleStatusText}"
                           Foreground="{Binding StatusColor, FallbackValue=Green}"
                           FontSize="12"/>
            </Border>
            
            <!--BUTTONS-->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Width="90"
                        Margin="0,0,8,0"
                        Click="OnCancelClicked"/>

                <Button Content="Upload"
                        Style="{StaticResource ButtonDefaultShadcn}"
                        Width="110"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding CanUpload}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
