<Window x:Class="BIMformative.DynamoExtension.UI.Views.ScriptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
        xmlns:vm="clr-namespace:BIMformative.DynamoExtension.UI.ViewModels"
        Width="1076"
        Height="720"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent"
        mc:Ignorable="d"
        Icon="/BIMformative.DynamoExtension;component/UI/Assets/bimformative-icon.ico">
    
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Colors.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Tab.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Image.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ContextMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!--Toast Animation-->
            <Storyboard x:Key="ToastStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="Toast"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.2" />
                <DoubleAnimation
                    Storyboard.TargetName="Toast"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    BeginTime="0:0:1.4"
                    Duration="0:0:0.3" />
            </Storyboard>
            
            <!--Window close animation-->
            <Storyboard x:Key="CloseStoryboard">
                <DoubleAnimation
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.3" />
            </Storyboard>
            
        </ResourceDictionary>        
    </Window.Resources>
    
    <!-- ============ ROOT ============ -->
    <Grid x:Name="Root">
        <Border x:Name="mainBorder"
            BorderBrush="#404040"
            BorderThickness="1"
            CornerRadius="6">
            <Border.Background>
                <RadialGradientBrush Center="0.5,-0.2"
                                 GradientOrigin="0.5,-0.2"
                                 RadiusX="0.8"
                                 RadiusY="0.8">
                    <GradientStop Color="#383854" Offset="0" />
                    <GradientStop Color="#FF000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrushWithOpacity}"
                    BorderThickness="0,0,0,1"
                    MouseDown="OnTitleBarMouseDown" />

                <!--Title Bar-->
                <Grid Grid.Row="0"
                  Margin="0"
                  VerticalAlignment="Top"
                  MouseDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                        <Image Source="pack://application:,,,/BIMformative.DynamoExtension;component/UI/Assets/logo-dark-2.png"                       
                           Height="24"
                           Margin="14,16,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Style="{StaticResource DropShadow}"/>

                        <TextBlock Text="Script Manager"
                               Margin="14,16,0,0"
                               FontFamily="{StaticResource BIMFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#E5E5E5"
                               TextAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                        <Button Margin="10,20,20,8"
                            VerticalAlignment="Center"
                            Style="{StaticResource CloseButonStyle}"
                            Click="OnCloseClicked"/>
                    </StackPanel>
                </Grid>

                <!--Body-->
                <Grid x:Name="TabsContent" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="detailsColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ContentGrid" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--Tabs-->
                        <TabControl Grid.Row="0"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab}"
                                ItemContainerStyle="{StaticResource ScriptManagerTabItemStyle}"
                                ItemTemplate="{StaticResource TabHeaderTemplate}"
                                Background="Transparent"
                                BorderThickness="0"
                                TabStripPlacement="Left" />

                        <!--Login Button-->
                        <Border Grid.Row="1"
                                Padding="12"
                                Background="#141414"
                                CornerRadius="0,0,0,6">
                            
                            
                            <Grid>
                                <!--SIGN IN BUTTON-->
                                <Button Content="Sign in"
                                        Command="{Binding SignInCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ButtonSecondary}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!--USER PROFILE-->
                                <Button ContextMenuService.Placement="Top">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="ContextMenu">
                                                <Setter.Value>
                                                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                                        <MenuItem Header="Sign out" Command="{Binding SignOutCommand}" />
                                                    </ContextMenu>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="DimGray"/>
                                                </Trigger>

                                                <EventTrigger RoutedEvent="Click">
                                                    <EventTrigger.Actions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="ContextMenu.IsOpen">
                                                                    <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True" />
                                                                </BooleanAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>                                                        
                                                    </EventTrigger.Actions>
                                                </EventTrigger>
                                            </Style.Triggers>                                            
                                        </Style>                                        
                                    </Button.Style>
                                    <Button.Content>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="32"
                                                     Height="32"
                                                     Margin="0,0,4,0"
                                                     Stroke="#E5E5E5"
                                                     StrokeThickness="1" >
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarUrl}"
                                                                Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1" Orientation="Vertical" MinWidth="400" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}"
                                                           FontFamily="{StaticResource BIMFont}"
                                                           FontSize="13"
                                                           Foreground="#E5E5E5"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Email}" 
                                                           FontSize="11" 
                                                           FontWeight="Regular" 
                                                           FontFamily="{StaticResource BIMFont}" 
                                                           Foreground="#E5E5E5"
                                                           Opacity="0.9"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>                            
                        </Border>
                    </Grid>
                    <ContentPresenter Grid.Column="1"
                                  x:Name="contentColumn"
                                  Content="{Binding SelectedTab.Content}" />
                    <Border Background="AntiqueWhite" Grid.Column="2" />
                </Grid>
            </Grid>
        </Border>
        
        <!--TOAST-->
        <Border Name="Toast"
                Background="#CC2ECC71"
                CornerRadius="6"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock Text="Script loaded successfully"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource BIMFont}" />
        </Border>
    </Grid>
</Window>
