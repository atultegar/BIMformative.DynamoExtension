<Window x:Class="BIMformative.DynamoExtension.UI.Views.ScriptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
        xmlns:vm="clr-namespace:BIMformative.DynamoExtension.UI.ViewModels"
        Width="1076"
        Height="720"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="Transparent"
        mc:Ignorable="d">

    <Window.DataContext>
        <vm:ScriptManagerViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Colors.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Tab.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Image.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>        
    </Window.Resources>
    
    <Border x:Name="mainBorder"
            BorderBrush="#404040"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Background>
            <RadialGradientBrush Center="0.5,-0.2"
                                 GradientOrigin="0.5,-0.2"
                                 RadiusX="0.8"
                                 RadiusY="0.8">
                <GradientStop Color="#7877C6" Offset="0" />
                <GradientStop Color="#FF000000" Offset="1" />
            </RadialGradientBrush>
        </Border.Background>
        
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrushWithOpacity}"
                    BorderThickness="0,0,0,1"
                    MouseDown="OnTitleBarMouseDown" />

            <!--Title Bar-->            
            <Grid Grid.Row="0"
                  Margin="0"
                  VerticalAlignment="Top"
                  MouseDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Image Source="pack://application:,,,/BIMformative.DynamoExtension;component/UI/Assets/logo-dark-2.png"                       
                           Height="24"
                           Margin="14,16,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Style="{StaticResource DropShadow}"/>

                    <TextBlock Text="Script Manager"
                               Margin="14,16,0,0"
                               FontFamily="{StaticResource BIMFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#E5E5E5"
                               TextAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button Margin="10,20,20,8"
                            VerticalAlignment="Center"
                            Style="{StaticResource CloseButonStyle}"
                            Click="OnCloseClicked"/> 
                </StackPanel>
            </Grid>
            
            <!--Body-->
            <Grid x:Name="TabsContent" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="detailsColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="ContentGrid" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--Tabs-->
                    <TabControl Grid.Row="0"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab}"
                                ItemContainerStyle="{StaticResource ScriptManagerTabItemStyle}"
                                ItemTemplate="{StaticResource TabHeaderTemplate}"
                                Background="Transparent"
                                BorderThickness="0"
                                TabStripPlacement="Left" />

                    <!--Login Button-->
                    <Border Grid.Row="1"
                            BorderThickness="0"
                            Padding="12">
                        <Button Content="Sign in"
                                Width="150"
                                Height="25"
                                FontFamily="{StaticResource BIMFont}"
                                FontSize="13"
                                Style="{StaticResource BIMPrimaryButton}" />
                    </Border>                    
                </Grid>
                <ContentPresenter Grid.Column="1"
                                  x:Name="contentColumn"
                                  Content="{Binding SelectedTab.Content}" />
                <Border Background="AntiqueWhite" Grid.Column="2" />
            </Grid>
        </Grid>        
    </Border>
</Window>
