<Window x:Class="BIMformative.DynamoExtension.UI.Views.ScriptBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
            xmlns:conv="clr-namespace:BIMformative.DynamoExtension.UI.Converters"
            Title="BIMformative - Browse Scripts"
            Width="800"
            Height="600"
            WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Colors.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Image.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/DataGrid.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <conv:ExpandToHeightConverter x:Key="ExpandToHeight" />
            <conv:ExpandToggleTextConverter x:Key="ExpandToggleText" />
        </ResourceDictionary>        
    </Window.Resources>
    
    <Window.Background>
        <RadialGradientBrush
            Center="0.5,-0.2"
            GradientOrigin="0.5,-0.2"
            RadiusX="0.8"
            RadiusY="0.8">

                    <GradientStop Color="#7877C6" Offset="0" />
                <GradientStop Color="#FF000000" Offset="1" />   
        </RadialGradientBrush>
    </Window.Background>
    <Grid Margin="10">
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8">
                <Image Source="pack://application:,,,/BIMformative.DynamoExtension;component/UI/Assets/logo-dark-2.png"                       
                       Height="24"
                       Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Style="{StaticResource DropShadow}"/>                

                <TextBlock Text="Dynamo Scripts"
                           FontFamily="{StaticResource BIMFont}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="White"/>

            </StackPanel>
            

            <DataGrid ItemsSource="{Binding Scripts}"
                      SelectedItem="{Binding SelectedScript}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="36"
                      Margin="8"
                      Background="Transparent"
                      RowBackground="Transparent"
                      Foreground="White"
                      FontFamily="{StaticResource BIMFont}"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      FontSize="14"
                      CellStyle="{StaticResource Body_Content_DataGrid_Centering}">
                
                <DataGrid.Columns>
                    <!-- Title -->
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />

                    <!-- Script Type -->
                    <DataGridTextColumn Header="Type" Binding="{Binding Script_Type}" Width="0.8*" />

                    <!-- Version -->
                    <DataGridTextColumn Header="Version" Binding="{Binding Current_Version_Number}" Width="0.8*" />

                    <!-- Likes -->
                    <DataGridTextColumn Header="Likes" Binding="{Binding Likes_Count}" Width="60" />
                    
                </DataGrid.Columns>
                
                <!--- Row Details-->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Margin="8,0,8,8"
                                Padding="12"
                                CornerRadius="6"
                                Background="#000000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Left: Metadata -->
                                <StackPanel Orientation="Vertical"
                                            Grid.Column="0"
                                            Margin="0,0,16,0" >

                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               Opacity="0.9"
                                               MaxWidth="500"
                                               MaxHeight="120"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,10,0,0"/>

                                    <TextBlock Text="{Binding OwnerFullName}"
                                               FontSize="11"
                                               Foreground="White"
                                               Opacity="0.7"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                                
                                <!-- Right: Actions -->
                                <StackPanel Orientation="Vertical"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,8,0,0">
                                    <Button Content="⬇ Download"
                                            Style="{StaticResource BIMPrimaryButton}"
                                            Command="{Binding DataContext.DownloadCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,10,0,0"/>

                                    <Button Content="🕓 Version history"
                                            Width="150"
                                            Height="25"
                                            Style="{StaticResource BIMSecondaryButton}"
                                            Command="{Binding DataContext.VersionsCommand,
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,10,0,0"/>                                    
                                </StackPanel>
                                
                                
                            </Grid>                            
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                
            </DataGrid>                     
        </StackPanel>            
    </Grid>
</Window>
