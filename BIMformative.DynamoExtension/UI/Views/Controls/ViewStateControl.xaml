<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.ViewStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views.Controls"
             xmlns:converters="clr-namespace:BIMformative.DynamoExtension.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ViewStateToVisibilityConverter x:Key="ViewStateVisibility"/>
        <Style TargetType="TextBlock" x:Key="ViewStateText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F5F5F0"/>
        </Style>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <TextBlock Text="Loading scripts..."
                   Style="{StaticResource ViewStateText}"
                   Visibility="{Binding CurrentState,
                    RelativeSource={RelativeSource AncestorType=UserControl},
                    Converter={StaticResource ViewStateVisibility},
                    ConverterParameter=Loading}"/>

        <TextBlock Text="No scripts yet"
                   Style="{StaticResource ViewStateText}"
                   Foreground="#C7C7C7"
               Visibility="{Binding CurrentState,
                RelativeSource={RelativeSource AncestorType=UserControl},
                Converter={StaticResource ViewStateVisibility},
                ConverterParameter=Empty}"/>

        <TextBlock Text="Something went wrong"
                   Style="{StaticResource ViewStateText}"
                   Foreground="#E7000B"
               Visibility="{Binding CurrentState,
                RelativeSource={RelativeSource AncestorType=UserControl},
                Converter={StaticResource ViewStateVisibility},
                ConverterParameter=Error}"/>

        <TextBlock Text="BIMformative server is unreachable."
                   Style="{StaticResource ViewStateText}"
                   Foreground="#E7000B"
               Visibility="{Binding CurrentState,
                RelativeSource={RelativeSource AncestorType=UserControl},
                Converter={StaticResource ViewStateVisibility},
                ConverterParameter=ApiUnavailable}"/>

    </Grid>
</UserControl>
