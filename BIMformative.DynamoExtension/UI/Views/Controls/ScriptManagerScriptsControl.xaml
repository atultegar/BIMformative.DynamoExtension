<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.ScriptManagerScriptsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
             xmlns:ViewModels="clr-namespace:BIMformative.DynamoExtension.UI.ViewModels.Scripts" d:DataContext="{d:DesignInstance Type=ViewModels:ScriptsListViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             UseLayoutRounding="True" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <DataTemplate x:Key="VersionInfoTemplate">
            <StackPanel MinWidth="111"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Orientation="Horizontal">
                <Button Width="18"
                        Height="18"
                        Margin="0,0,5,0"
                        Focusable="False">
                </Button>
            </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        
        <!--RESULT LIST BOX-->
        <ListBox Name="scriptsListBox"
                 Background="#2A2A2A"
                 BorderThickness="0"
                 ItemsSource="{Binding Scripts}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Loaded="ScriptsListBox_Loaded">

            <ListBox.Resources>
                <SolidColorBrush x:Key="ForegroundGrayBrush" Color="#D8D8D8" />
                <SolidColorBrush x:Key="HasVotedBlueBrush" Color="#84D7CE" />

                <Style x:Key="resultLabelStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource BIMFont}" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="#C7C7C7" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeprecated}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>    
                    </Style.Triggers>
                </Style>                
            </ListBox.Resources>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            
            <!--The template for all script search results-->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Name="resultItemTemplate" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        
                        <!--Top Row-->
                        <DockPanel Name="resultTopRow"
                                   Grid.Row="0"
                                   Margin="15,15,5,0"
                                   LastChildFill="False">
                            
                            <!--Load button-->
                            <Button Name="loadButton"
                                    Content="{Binding LoadButtonText}"
                                    Command="{Binding DownloadCommand}"
                                    CommandParameter="{Binding}"
                                    DockPanel.Dock="Right"
                                    IsEnabled="True"
                                    Style="{StaticResource loadButton}">
                            </Button>
                            
                            <!--The Version ComboBox-->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <StackPanel MinHeight="120"
                                            Margin="5,0,5,0"                                            
                                            Orientation="Vertical">
                                    <!--<ComboBox x:Name="VersionCombobox"
                                              HorizontalAlignment="Left"
                                              ItemTemplate="{StaticResource VersionInfoTemplate}">                                        
                                    </ComboBox>-->
                                    <Button Content="Versions"
                                            Command="{Binding VersionHistoryCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource loadButton}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!--Script Title and Type-->
                            <Grid Margin="0,0,0,0" DockPanel.Dock="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <!--Script Title-->
                                <TextBlock Name="scriptName"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource BIMFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeprecated}" Value="True">
                                                    <Setter Property="Foreground" Value="#999999" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDeprecated}" Value="False">
                                                    <Setter Property="Foreground" Value="#DFDFDF" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Title}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                
                                <!--Tag Bubble-->
                                <Border Name="newScriptLabel"
                                        Grid.Column="1"
                                        Width="Auto"
                                        Height="20"
                                        Margin="7,-3,7,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="#5F5F5F"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True"
                                        Visibility="Visible">
                                    <TextBlock Margin="3,0"
                                               Padding="0,1,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource BIMFont}"
                                               FontWeight="Regular"
                                               FontSize="11"
                                               Foreground="#DFDFDF"
                                               Text="{Binding ScriptLabel}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding ScriptLabel}" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Border>
                            </Grid>                                    
                        </DockPanel>
                        
                        <!--Middle Row-->
                        <DockPanel Name="typeRow"
                                   Grid.Row="1"
                                   Margin="15,0,0,0"
                                   VerticalAlignment="Center"
                                   LastChildFill="False">
                            <Rectangle Width="12"
                                       Height="12"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"
                                       Visibility="Visible">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/workflow.png" 
                                                Opacity="0.5"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="requirementsLabel"
                                       Margin="5,0"
                                       DockPanel.Dock="Left"
                                       Style="{StaticResource resultLabelStyle}"
                                       Text="{Binding ScriptType}" />
                        </DockPanel>
                        
                        <!--Bottom Row-->
                        <DockPanel Name="resultBottomRow"
                                   Grid.Row="2"
                                   Margin="15,0,5,15"
                                   VerticalAlignment="Bottom"
                                   LastChildFill="True">
                            
                            <!--Right-hand side-->
                            <Grid VerticalAlignment="Center" DockPanel.Dock="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="94" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!--Number of Likes label-->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Viewbox Width="12"
                                             Height="12"
                                             Margin="5,0,0,2"
                                             VerticalAlignment="Center">
                                        <Path x:Name="lucideThumbsUpIcon"
                                              VerticalAlignment="Center"
                                              Data="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"
                                              Stroke="#D8D8D8"
                                              StrokeThickness="1" />
                                    </Viewbox>
                                    <TextBlock Name="noLikesLabel"
                                               Margin="5,0,27,0"
                                               Style="{StaticResource resultLabelStyle}"
                                               Text="{Binding LikesCount}" />
                                </StackPanel>

                                <!--Number of Downloads label-->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Rectangle Width="10"
                                             Height="10"
                                             Margin="5,0,0,2"
                                             VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/Download.png" />
                                        </Rectangle.Fill>                                        
                                    </Rectangle>
                                    <TextBlock Name="noDownloadsLabel"
                                               Margin="5,0,27,0"
                                               Style="{StaticResource resultLabelStyle}"
                                               Text="{Binding DownloadsCount}" />
                                </StackPanel>

                                <!--Date Label-->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Rectangle Width="10"
                                               Height="10"
                                               Margin="5,0,0,2"
                                               VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/Date.png" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Name="dateLabel"
                                               Margin="5,0,27,0"
                                               Style="{StaticResource resultLabelStyle}"
                                               Text="{Binding UpdatedAtDisplay}" />
                                </StackPanel>
                                
                                <!--View Details Button-->
                                <Button Name="moreDetailsButton"
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Click="MoreDetailsButton_OnClick"
                                        Content="More Details">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="ButtonBorder"
                                                    Height="25"
                                                    Padding="5,0"
                                                    BorderThickness="2"
                                                    CornerRadius="2">
                                                <Grid x:Name="moreDetailsGrid">
                                                    <DockPanel>
                                                        <TextBlock Name="textBlock"
                                                                   Padding="4,4,4,3"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="{StaticResource BIMFont}"
                                                                   FontWeight="Regular"
                                                                   FontSize="10"
                                                                   Foreground="#B8B8B8"
                                                                   Text="More Details" />
                                                        <Viewbox Width="14"
                                                                 Height="14"
                                                                 Margin="0,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 DockPanel.Dock="Left"
                                                                 UseLayoutRounding="True">
                                                            <Path Data="M7 0C3.13401 0 0 3.13401 0 7C0 10.866 3.13401 14 7 14C10.866 14 14 10.866 14 7C14 5.14348 13.2625 3.36301 11.9497 2.05025C10.637 0.737498 8.85652 0 7 0ZM8 11H6V6H8V11ZM7 5.25C6.30964 5.25 5.75 4.69036 5.75 4C5.75 3.30964 6.30964 2.75 7 2.75C7.69036 2.75 8.25 3.30964 8.25 4C8.25 4.33152 8.1183 4.64946 7.88388 4.88388C7.64946 5.1183 7.33152 5.25 7 5.25Z"
                                                                  Fill="#999999" />
                                                        </Viewbox>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4A4A4A" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5F5F5F" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </Grid>
                            
                            <!--Left-hand side-->
                            <Rectangle Width="12"
                                       Height="12"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/circle-user-round.png" 
                                                Opacity="0.5"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Name="ownerName"
                                       Margin="5,0"
                                       DockPanel.Dock="Left"
                                       Style="{StaticResource resultLabelStyle}"
                                       Text="{Binding OwnerFullName}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        
                        <!--A 1px bar that separates List Items-->
                        <Rectangle Name="separator"
                                   Grid.Row="2"
                                   Height="1"
                                   VerticalAlignment="Bottom"
                                   Fill="#535353" />
                    </Grid>
                    <!--<DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasLiked}" Value="True">
                            <Setter TargetName="lucideThumbsUpIcon" Property="Fill" Value="{StaticResource HasVotedBlueBrush}" />
                            <Setter TargetName="lucideThumbsUpIcon" Property="Stroke" Value="{StaticResource HasVotedBlueBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>-->
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>      
        
    </Grid>
</UserControl>
