<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.ScriptManagerScriptsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
             xmlns:ViewModels="clr-namespace:BIMformative.DynamoExtension.UI.ViewModels.Scripts" 
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             UseLayoutRounding="True" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ScrollBar.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Border.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        
        <!--RESULT LIST BOX-->
        <ListView Name="scriptsListBox"
                 Background="{StaticResource ControlsBackgroundBrush}"
                 BorderThickness="0"
                 ItemsSource="{Binding Scripts}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Loaded="ScriptsListBox_Loaded">

            <ListView.Resources>
                <SolidColorBrush x:Key="ForegroundGrayBrush" Color="#D8D8D8" />
                <SolidColorBrush x:Key="HasVotedBlueBrush" Color="#84D7CE" />

                
                <Style TargetType="ScrollBar" BasedOn="{StaticResource StylishScrollBar}" />
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            
            <!--The template for all script search results-->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,12"
                            BorderBrush="#2A2A2A"
                            BorderThickness="0,0,0,1"
                            HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E1E1E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!--Top Row-->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!--Title-->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#E5E5E5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border Width="Auto"
                                            Height="20"
                                            Margin="7,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="4"
                                                   FontWeight="Regular"
                                                   FontSize="11"
                                                   Foreground="#DFDFDF"
                                                   Text="{Binding ScriptLabel}"/>
                                    </Border>
                                </StackPanel>
                                
                                
                                <!--Load Button-->
                                <Button Grid.Column="1"
                                        Command="{Binding LoadCommand}"
                                        Content="{Binding LoadButtonText}"
                                        Style="{StaticResource IconCountButton}"
                                        Tag="/BIMformative.DynamoExtension;component/UI/Assets/download-icon-white-2.png"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        MinWidth="60"
                                        Background="{StaticResource PrimaryBrush}"
                                        Foreground="{StaticResource PrimaryForegroundBrush}"
                                        IsEnabled="{Binding CanLoad}"
                                        VerticalAlignment="Center"/>
                                
                                <!--More Button-->
                                <Button Grid.Column="2"
                                        Command="{Binding ViewDetailsCommand}"
                                        Content="Details"
                                        Style="{StaticResource IconCountButton}"
                                        Tag="/BIMformative.DynamoExtension;component/UI/Assets/more-details-white.png"
                                        Margin="8,0,0,0"
                                        Padding="8,4"
                                        Background="Transparent"
                                        Foreground="{StaticResource MutedForegroundBrush}"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            
                            <!--Bottom Row-->
                            <Grid Grid.Row="1"
                                  Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" 
                                            Orientation="Horizontal">
                                    <Rectangle Width="16"
                                               Height="16"
                                               Margin="5,0,5,0"
                                               VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/workflow-white.png"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="{Binding ScriptType}"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>                                    
                                </StackPanel>


                                <StackPanel Grid.Column="1" 
                                            Orientation="Horizontal">
                                    <Rectangle Width="16"
                                               Height="16"
                                               Margin="5,0,5,0"
                                               VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/user-icon-white.png"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="{Binding OwnerFullName}"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">
                                    <Rectangle Width="16"
                                               Height="16"
                                               Margin="5,0,5,0"
                                               VerticalAlignment="Center">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/clock-icon-white.png"/>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="{Binding UpdatedAt}"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedForegroundBrush}"
                                               Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    
                                </StackPanel>
                                
                                <Border Grid.Column="3" 
                                        Style="{StaticResource BorderStyle}"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Width="60">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Rectangle Width="16"
                                                   Height="16"
                                                   Margin="2,0,0,0"
                                                   VerticalAlignment="Center">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/download-icon-white.png" 
                                                            Opacity="0.85"/>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <TextBlock Text="{Binding DownloadsCount}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   Margin="5,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" 
                                        Style="{StaticResource BorderStyle}"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Width="60">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Rectangle Width="16"
                                                   Height="16"
                                                   Margin="2,0,0,0"
                                                   VerticalAlignment="Center">
                                            
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/thumbs-up-white.png" 
                                                            Opacity="0.85"/>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <TextBlock Text="{Binding LikesCount}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedForegroundBrush}"
                                                   Margin="5,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!--STATUS BAR-->
        <Border Grid.Row="1"
                Background="#141414"
                CornerRadius="0,0,6,0">
            <TextBlock HorizontalAlignment="Right"  
                       Margin="10,0,20,0"
                       Text="{Binding TotalScripts, StringFormat= {}{0:N0} total script(s), FallbackValue=100 scripts}"
                       Foreground="{StaticResource SecondaryBrush}"
                       VerticalAlignment="Center"
                       FontWeight="Medium"
                       FontSize="12"/>            
        </Border>
    </Grid>
</UserControl>
