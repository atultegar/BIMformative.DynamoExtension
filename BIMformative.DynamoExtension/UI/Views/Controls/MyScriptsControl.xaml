<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.MyScriptsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
             xmlns:converters="clr-namespace:BIMformative.DynamoExtension.UI.Converters"
             xmlns:controls="clr-namespace:BIMformative.DynamoExtension.UI.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrushWithOpacity}" BorderThickness="1">
        <Border.Resources>
            <converters:ViewStateToVisibilityConverter x:Key="ViewStateVisibility"/>
        </Border.Resources>
        
        <Grid Background="{StaticResource ControlsBackgroundBrush}"
              UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="AUto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16,16,25,8"
                    BorderThickness="0">
                <DockPanel LastChildFill="True">
                    <!--SEARCH BOX-->
                    <controls:SearchBoxControl x:Name="SearchBox"
                                               SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Margin="0,5,0,0"
                                               DockPanel.Dock="Left"/>
                </DockPanel>
            </Border>
            
            <!--RESULTS-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Scripts.IsDetailOpen}" Value="True">
                                        <Setter Property="Width" Value="450"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <!--Loading State-->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Scripts.MyCurrentState,
                                                            Converter={StaticResource ViewStateVisibility},
                                                            ConverterParameter=Loading}">
                    <TextBlock Text="Loading scripts..."
                               FontSize="14"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!--Empty State-->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Scripts.MyCurrentState,
                                            Converter={StaticResource ViewStateVisibility},
                                            ConverterParameter=Empty}">
                    <TextBlock Text="No scripts yet"
                               FontSize="14"
                               Foreground="#C7C7C7"/>
                </StackPanel>                

                <!--Error State-->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Scripts.MyCurrentState,
                            Converter={StaticResource ViewStateVisibility},
                            ConverterParameter=Error}">
                    <TextBlock Text="Something went wrong."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E7000B"/>
                </StackPanel>

                <!--API Error State-->
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Scripts.MyCurrentState,
                    Converter={StaticResource ViewStateVisibility},
                    ConverterParameter=ApiUnavailable}">

                    <TextBlock Text="BIMformative server is unreachable."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E7000B"/>
                </StackPanel>

                <!--API Error State-->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Scripts.MyCurrentState,
                    Converter={StaticResource ViewStateVisibility},
                    ConverterParameter=NotAuthenticated}">

                    <TextBlock Text="&#xE72E;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E7000B"/>
                    <TextBlock Text="Please login to view your scripts"
                               Margin="5,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E7000B"/>
                </StackPanel>
                <!--SCRIPT LIST-->
                <controls:MyScriptsListControl x:Name="scriptManagerSearchScripts"
                                               DataContext="{Binding Scripts}"
                                               Grid.Column="0"
                                               Visibility="{Binding Scripts.MyCurrentState,
                                                            Converter={StaticResource ViewStateVisibility},
                                                            ConverterParameter=Loaded}"/>
                
                <!--DETAILS PANEL-->
                <Border Grid.Column="1"
                        Background="{StaticResource ControlsBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushWithOpacity}"
                        BorderThickness="1,0,0,0"
                        Padding="16">
                    <controls:ScriptDetailsControl
                        DataContext="{Binding Scripts.SelectedDetails}"/>
                </Border>
            </Grid>            
        </Grid>            
    </Border>
</UserControl>
