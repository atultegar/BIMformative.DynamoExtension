<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.InstalledScriptsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
             xmlns:models="clr-namespace:BIMformative.DynamoExtension.Models"
             xmlns:controls="clr-namespace:BIMformative.DynamoExtension.UI.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ScrollBar.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ContextMenu.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Image.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Margin" Value="0,0,11,0"/>
                <Setter Property="Background" Value="#535353"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Height" Value="22"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrushWithOpacity}" BorderThickness="1">
        <Grid Background="{StaticResource ControlsBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16,16,25,8"
                    BorderThickness="0"
                    Background="Transparent">
                <DockPanel LastChildFill="True">
                    
                    <Button Content="Check for updates"
                            Style="{StaticResource ButtonDefaultShadcn}"
                            Width="150"
                            Height="10"
                            Command="{Binding CheckForUpdatesCommand}"
                            DockPanel.Dock="Right"/>

                    <Button Content="Refresh"
                            Style="{StaticResource ButtonSecondary}"
                            Width="100"
                            Height="10"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,10,0"
                            DockPanel.Dock="Right"/>
                    
                    <controls:SearchBoxControl x:Name="SearchBox"
                                               SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Margin="0,0,5,0"
                                               DockPanel.Dock="Left"/>


                </DockPanel>

            </Border>
            

            <Border Grid.Row="1" Background="#444" Height="1"/>
            <ScrollViewer Grid.Row="2">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StylishScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding ScriptsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#444"
                                    BorderThickness="0,0,0,1"
                                    Margin="15,0,0,0"
                                    Padding="0,10">
                                <Grid>
                                    <DockPanel HorizontalAlignment="Stretch">
                                        <StackPanel HorizontalAlignment="Left"
                                                    Orientation="Horizontal"
                                                    Margin="10,5,5,7">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Width="200"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0"
                                                       Foreground="{StaticResource PrimaryForegroundBrush}" />
                                            <Border Width="Auto"
                                                    Height="Auto"
                                                    Margin="10,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderBrush="#3A3A3A"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <TextBlock Text="{Binding DownloadedVersion}"
                                                           FontSize="12"       
                                                           VerticalAlignment="Center"
                                                           Padding="4"
                                                           Foreground="{StaticResource SecondaryBrush}"/>                                                
                                            </Border>
                                            
                                            <Border Style="{StaticResource BorderStyle}">
                                                <Border.ToolTip>
                                                    <ToolTip Content="Downloaded at"/>
                                                </Border.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="16" 
                                                               Height="16"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center">
                                                        <Rectangle.Fill>
                                                            <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/clock-icon.png"
                                                                        Opacity="0.85"/>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="Black"
                                                               Text="{Binding DownloadedAt}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding FilePath}"
                                                       FontSize="12"
                                                       Width="250"           
                                                       VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="15,0,10,0"
                                                       Foreground="{StaticResource SecondaryBrush}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding FilePath}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>

                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Width="Auto">
                                            <Grid Height="18"
                                                  MaxWidth="250"
                                                  Margin="5,0">
                                                <Border Name="Badge" HorizontalAlignment="Stretch"
                                                        CornerRadius="8"
                                                        Margin="5,0,0,0"
                                                        Padding="5,0,5,0">                                                    
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ScriptSyncStatus.UpToDate}">
                                                                    <Setter Property="Background" Value="#2e7d32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ScriptSyncStatus.Downloaded}">
                                                                    <Setter Property="Background" Value="#2e7d32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ScriptSyncStatus.UpdateAvailable}">
                                                                    <Setter Property="Background" Value="#ed6c02"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ScriptSyncStatus.ModifiedLocally}">
                                                                    <Setter Property="Background" Value="#0288d1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ScriptSyncStatus.Conflict}">
                                                                    <Setter Property="Background" Value="#d32f2f"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ScriptSyncStatus.MissingFile}">
                                                                    <Setter Property="Background" Value="#616161"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="10"
                                                               FontWeight="Medium"
                                                               TextAlignment="Left"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,2,0,0"
                                                               Foreground="{StaticResource PrimaryForegroundBrush}"/>
                                                </Border>
                                            </Grid>
                                            <Button Name="MoreButton"
                                                    Click="MoreButton_Click"
                                                    Style="{StaticResource ContextMenuButton}"
                                                    Background="Transparent"
                                                    Padding="5"
                                                    ContextMenuService.Placement="Relative"
                                                    ContextMenuService.HorizontalOffset="-115"
                                                    ContextMenuService.VerticalOffset="35">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource ContextMenuNoLeftColumnStyle}">                                                        
                                                        <MenuItem Name="Load"
                                                                  Header="Load"
                                                                  Padding="5"
                                                                  Tag="/BIMformative.DynamoExtension;component/UI/Assets/download-icon-white.png"
                                                                  Style="{StaticResource MenuItemCollapseStyle}"
                                                                  Command="{Binding LoadCommand}"
                                                                  ToolTip="Load script in Dynamo"/>

                                                        <MenuItem Name="GoToDirectory"          
                                                                  Header="Go to directory"
                                                                  Tag="/BIMformative.DynamoExtension;component/UI/Assets/folder-open-white.png"
                                                                  Style="{StaticResource MenuItemCollapseStyle}"
                                                                  Command="{Binding OpenDirectoryCommand}"
                                                                  ToolTip="Go to downloaded directory" />
                                                        
                                                        <MenuItem Name="Compare"
                                                                  Header="Compare version"
                                                                  Tag="/BIMformative.DynamoExtension;component/UI/Assets/git-compare-white.png"
                                                                  Style="{StaticResource MenuItemCollapseStyle}"                                                                  
                                                                  Command="{Binding CompareVersionCommand}"
                                                                  ToolTip="Compare with latest version online"/>
                                                        
                                                        <Separator Width="Auto" Style="{StaticResource ContextMenuSeparatorStyle}" />

                                                        <MenuItem Name="Delete"
                                                                  Header="Delete"
                                                                  Tag="/BIMformative.DynamoExtension;component/UI/Assets/triangle-alert-red.png"
                                                                  Style="{StaticResource MenuItemCollapseStyle}"
                                                                  Foreground="#e7000b"
                                                                  Command="{Binding DeleteCommand}"
                                                                  ToolTip="Delete script from local directory"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
