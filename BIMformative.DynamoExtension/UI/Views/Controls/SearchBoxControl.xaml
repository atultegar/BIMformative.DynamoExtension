<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"             >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Image.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="15 10 5 5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource BIMFont}"/>
                <Setter Property="Foreground" Value="#F5F5F5"></Setter>
            </Style>
            <Style x:Key="TextBlockStyle" TargetType="TextBlock">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="15 10 5 5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource BIMFont}"/>
                <Setter Property="Foreground" Value="#F5F5F5"></Setter>
            </Style>
            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="0 0 0 1"></Setter>
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="BorderBrush" Value="#666666"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=IsMouseOver}" Value="True">
                        <Setter Property="BorderBrush" Value="#CCCCCC"></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=IsFocused}" Value="True">
                        <Setter Property="BorderBrush" Value="#38ABDF"></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RectangleStyle" TargetType="Rectangle">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Fill" Value="#BCD3EE"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=IsFocused}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard SpeedRatio="2">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0.75" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard SpeedRatio="2">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border CornerRadius="4"
            Background="#2D2D30"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            Height="32"
            Padding="6,0">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            
            <!--SEARCH ICON-->
            <TextBlock Grid.Column="0"
                       Text="&#xE721;"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#C7C7C7"/>
            
            <!--TEXTBOX-->
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Padding="6,0"
                     x:Name="SearchTextBox"/>
            
            <!--CLEAR BUTTON-->
            <Button Grid.Column="2"
                    Width="16"
                    Height="16"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="ClearSearch_Click"
                    x:Name="ClearButton">
                <TextBlock Text="&#xE711;"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           Foreground="#C7C7C7"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

        </Grid>
        
    </Border>
</UserControl>
