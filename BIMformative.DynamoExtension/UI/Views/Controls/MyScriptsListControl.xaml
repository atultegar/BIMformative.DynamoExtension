<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.MyScriptsListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Fonts.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ScrollBar.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ContextMenu.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Border.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!--RESULT LIST BOX-->
        <ScrollViewer Grid.Row="1">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource StylishScrollBar}"/>
            </ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding MyScripts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        
                        <Border BorderBrush="#2A2A2A"
                                BorderThickness="0,0,0,1"
                                Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E1E1E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!--TOP ROW-->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!--Visibility Badge-->
                                    <Border CornerRadius="8"
                                            Height="18"
                                            Padding="6,1"
                                            Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ED6C02"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPublic}" Value="Public">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding IsPublic}"
                                                   FontSize="10"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    
                                    <!--Title-->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    
                                    <!--3 Dot Menu-->
                                    <Button Grid.Column="2"
                                            Click="MoreButton_Click"
                                            Style="{StaticResource ContextMenuButton}"
                                            Background="Transparent">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource ContextMenuNoLeftColumnStyle}">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemCollapseStyle}"/>
                                                </ContextMenu.Resources>
                                                
                                                <MenuItem Header="View Details"
                                                          Tag="/BIMformative.DynamoExtension;component/UI/Assets/folder-open-white.png"
                                                          Command="{Binding ViewDetailsCommand}"/>
                                                
                                                <MenuItem Header="Load"
                                                          Tag="/BIMformative.DynamoExtension;component/UI/Assets/download-icon-white.png"
                                                          Command="{Binding LoadCommand}"/>
                                                
                                                <MenuItem Header="Edit Script"
                                                          Tag="/BIMformative.DynamoExtension;component/UI/Assets/square-pen-white.png"
                                                          Command="{Binding EditScriptCommand}"/>

                                                <MenuItem Header="Upload Version"
                                                          Tag="/BIMformative.DynamoExtension;component/UI/Assets/upload-icon-white.png"
                                                          Command="{Binding UploadVersionCommand}"/>
                                                
                                                <Separator Width="Auto" Style="{StaticResource ContextMenuSeparatorStyle}"/>

                                                <MenuItem Header="{Binding MakeButtonText, FallbackValue=MakePrivate}"
                                                          Tag="/BIMformative.DynamoExtension;component/UI/Assets/lock-icon-white.png"
                                                          Command="{Binding ChangeVisibilityCommand}"/>
                                                
                                                <MenuItem Header="Delete"
                                                          Tag="/BIMformative.DynamoExtension;component/UI/Assets/triangle-alert-red.png"
                                                          Foreground="#E7000B"
                                                          Command="{Binding DeleteScriptCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                                
                                <!--SECONDARY META ROW-->
                                <Grid Grid.Row="1"
                                      Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="75"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ScriptType}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               Margin="5,0"
                                               VerticalAlignment="Center"/>


                                    <Border Grid.Column="1"
                                            Width="Auto"
                                            Height="25"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding CurrentVersion}"
                                                   FontSize="12"
                                                   FontWeight="Regular"
                                                   Foreground="{StaticResource SecondaryBrush}"
                                                   Padding="4"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding UpdatedAt}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               Margin="10,0"
                                               VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Column="3" 
                                            Style="{StaticResource BorderStyle}"
                                            HorizontalAlignment="Center"
                                            Width="60">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Rectangle Width="16"
                                                       Height="16"
                                                       Margin="2,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/download-icon-white.png" 
                                                                Opacity="0.85"/>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <TextBlock Text="{Binding DownloadsCount}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryBrush}"
                                                       Margin="5,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" 
                                            Style="{StaticResource BorderStyle}"
                                            HorizontalAlignment="Center"
                                            Width="60">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Rectangle Width="16"
                                                       Height="16"
                                                       Margin="2,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="/BIMformative.DynamoExtension;component/UI/Assets/thumbs-up-white.png" 
                                                                Opacity="0.85"/>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <TextBlock Text="{Binding LikesCount}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryBrush}"
                                                       Margin="5,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>                                     
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--STATUS BAR-->
        <Border Grid.Row="2"
        Background="#141414"
        CornerRadius="0,0,6,0">
            <TextBlock HorizontalAlignment="Right"                      
                       Margin="10,0,20,0"
                       Text="{Binding MyScriptsTotal, StringFormat= {}{0:N0} total script(s), FallbackValue=100 scripts}"
                       Foreground="{StaticResource SecondaryBrush}"
                       VerticalAlignment="Center"
                       FontWeight="Medium"
                       FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
