<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.SearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
             xmlns:vm="clr-namespace:BIMformative.DynamoExtension.UI.ViewModels.Search"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ContextMenu.xaml" />
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrushWithOpacity}" BorderThickness="1">
        <Grid x:Name="SearchRoot"
              Background="{StaticResource ControlsBackgroundBrush}"
              UseLayoutRounding="True">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--SEARCH BAR / TOOLBAR-->
            <Border Grid.Row="0"
            Padding="16,16,25,12"
            BorderThickness="0"
            Background="Transparent">
                <DockPanel LastChildFill="True">

                    <!--SORT BUTTON-->
                    <Button Width="20"
                    Height="20"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    DockPanel.Dock="Right"
                    Command="{Binding OpenSortMenuCommand}">
                        <Button.ToolTip>
                            <ToolTip Content="Sort scripts" />
                        </Button.ToolTip>
                        <Button.Template>
                            <ControlTemplate>
                                <Image Width="16"
                               Height="16"
                               Source="/BIMformative.DynamoExtension;component/UI/Assets/Sort.png" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!--FILTER BUTTON-->
                    <Button Width="20"
                    Height="20"
                    Margin="20,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    DockPanel.Dock="Right"
                    Command="{Binding OpenFilterMenuCommand}">
                        <Button.ToolTip>
                            <ToolTip Content="Filter scripts" />
                        </Button.ToolTip>
                        <Button.Template>
                            <ControlTemplate>
                                <Image Width="16"
                               Height="16"
                               Source="/BIMformative.DynamoExtension;component/UI/Assets/Filter.png" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>


                    <!--SEARCH BOX-->
                    <local:SearchBoxControl x:Name="SearchBox"
                                            SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,5,0,0"
                                            DockPanel.Dock="Left"/>
                </DockPanel>
            </Border>

            <!--RESULTS-->
            <Grid Grid.Row="1">
                <local:ScriptManagerScriptsControl x:Name="scriptManagerSearchScripts"
                                                   DataContext="{Binding Scripts}"
                                           Grid.Row="2" />
            </Grid>
        </Grid>

    </Border>
    
</UserControl>
