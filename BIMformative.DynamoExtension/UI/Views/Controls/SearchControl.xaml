<UserControl x:Class="BIMformative.DynamoExtension.UI.Views.Controls.SearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:BIMformative.DynamoExtension.UI.Views"
             xmlns:controls="clr-namespace:BIMformative.DynamoExtension.UI.Views.Controls"
             xmlns:vm="clr-namespace:BIMformative.DynamoExtension.UI.ViewModels.Search"
             xmlns:localConverters="clr-namespace:BIMformative.DynamoExtension.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml" />
            </ResourceDictionary.MergedDictionaries>            
        </ResourceDictionary>
        
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrushWithOpacity}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!--TOOLBAR-->
            <controls:SearchToolbarControl Grid.Row="0" DataContext="{Binding}"/>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Scripts.IsDetailOpen}" Value="True">
                                        <Setter Property="Width" Value="450"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <!--LEFT : RESULTS-->
                <controls:SearchResultsControl DataContext="{Binding Scripts}" Grid.Column="0"/>
                
                <!--RIGHT : DETAILS-->
                <Border Grid.Column="1"
                        Background="{StaticResource ControlsBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushWithOpacity}"
                        BorderThickness="1,0,0,0"
                        Padding="16">
                    <controls:ScriptDetailsControl DataContext="{Binding Scripts.SelectedDetails}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>    
</UserControl>
