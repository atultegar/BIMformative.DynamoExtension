<Window x:Class="BIMformative.DynamoExtension.UI.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BIMformative.DynamoExtension.UI.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Compare Script Versions" 
        Height="800" 
        Width="1280">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ScrollBar.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/BIMformative.DynamoExtension;component/UI/Styles/ContextMenu.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Margin" Value="0,0,11,0"/>
                <Setter Property="Background" Value="#535353"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="Height" Value="22"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#404040">
        <Border.Background>
            <RadialGradientBrush Center="0.5,-0.2"
                     GradientOrigin="0.5,-0.2"
                     RadiusX="0.8"
                     RadiusY="0.8">
                <GradientStop Color="#383854" Offset="0" />
                <GradientStop Color="#FF000000" Offset="1" />
            </RadialGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <wv2:WebView2 Grid.Row="0" x:Name="webView" />

            <Border Grid.Row="1" Background="#444" Height="1"/>

            <StackPanel Orientation="Horizontal" 
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">

                <Button Content="Cancel"
                        Style="{StaticResource ButtonSecondary}"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                
                <Button Content="Update"
                        x:Name="UpdateButton"
                        Style="{StaticResource ButtonDefaultShadcn}"
                        Width="100"
                        Command="{Binding UpdateCommand}"/>
            </StackPanel>
        </Grid>
    </Border>    
</Window>
