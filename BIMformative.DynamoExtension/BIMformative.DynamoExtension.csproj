<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>latest</LangVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		
		<!--Assembly-->
		<RootNamespace>BIMformative.DynamoExtension</RootNamespace>
		<AssemblyName>BIMformative.DynamoExtension</AssemblyName>
		
		<Configurations>
			Debug;Release;Debug-Revit2023;Debug-Revit2024;Debug-Revit2025;Debug-Revit2026;
			Release-Revit2023;Release-Revit2024;Release-Revit2025;Release-Revit2026;
			Debug-C3D2023;Debug-C3D2024;Debug-C3D2025;Debug-C3D2026;
			Release-C3D2023;Release-C3D2024;Release-C3D2025;Release-C3D2026
		</Configurations>

		<PackageOutputRoot>$(MSBuildProjectDirectory)\artifacts\$(Configuration)\</PackageOutputRoot>
		
		<Platforms>x64</Platforms>
    </PropertyGroup>
	
	<!--Revit version selection-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug-Revit2023' or '$(Configuration)' == 'Release-Revit2023'">
		<HostProduct>Revit</HostProduct>
		<HostYear>2023</HostYear>
		<DefineConstants>$(DefineConstants);REVIT2023;NET48</DefineConstants>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug-Revit2024' or '$(Configuration)' == 'Release-Revit2024'">
		<HostProduct>Revit</HostProduct>
		<HostYear>2024</HostYear>
		<DefineConstants>$(DefineConstants);REVIT2024;NET48</DefineConstants>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug-Revit2025' or '$(Configuration)' == 'Release-Revit2025'">
		<HostProduct>Revit</HostProduct>
		<HostYear>2025</HostYear>
		<DefineConstants>$(DefineConstants);REVIT2025;NET8_0_WINDOWS</DefineConstants>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug-Revit2026' or '$(Configuration)' == 'Release-Revit2026'">
		<HostProduct>Revit</HostProduct>
		<HostYear>2026</HostYear>
		<DefineConstants>$(DefineConstants);REVIT2026;NET8_0_WINDOWS</DefineConstants>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>

	<!--Civil 3D version selection-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug-C3D2023' or '$(Configuration)' == 'Release-C3D2023'">
		<HostProduct>Civil3D</HostProduct>
		<HostYear>2023</HostYear>
		<DefineConstants>$(DefineConstants);CIVIL3D2023;C3D2023;NET48</DefineConstants>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug-C3D2024' or '$(Configuration)' == 'Release-C3D2024'">
		<HostProduct>Civil3D</HostProduct>
		<HostYear>2024</HostYear>
		<DefineConstants>$(DefineConstants);CIVIL3D2024;C3D2024;NET48</DefineConstants>
		<TargetFramework>net48</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug-C3D2025' or '$(Configuration)' == 'Release-C3D2025'">
		<HostProduct>Civil3D</HostProduct>
		<HostYear>2025</HostYear>
		<DefineConstants>$(DefineConstants);CIVIL3D2025;C3D2025;NET8_0_WINDOWS</DefineConstants>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug-C3D2026' or '$(Configuration)' == 'Release-C3D2026'">
		<HostProduct>Civil3D</HostProduct>
		<HostYear>2026</HostYear>
		<DefineConstants>$(DefineConstants);CIVIL3D2026;C3D2026;NET8_0_WINDOWS</DefineConstants>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	
	<!--Fallback to 2025 if config not selected-->
	<PropertyGroup Condition="'$(HostProduct)' == ''">
		<HostProduct>Revit</HostProduct>
		<HostYear>2025</HostYear>
		<DefineConstants>$(DefineConstants);REVIT2025;NET8_0_WINDOWS</DefineConstants>
		<TargetFramework>net8.0-windows</TargetFramework>
	</PropertyGroup>
	
	<!--Output-->
	<PropertyGroup>
		<OutputPath>bin\$(Configuration)\</OutputPath>
	</PropertyGroup>
	
	
	<!--Host-specific install paths-->
	<PropertyGroup Condition="'$(HostProduct)' == 'Revit'">
		<HostInstallRoot>C:\Program Files\Autodesk\Revit $(HostYear)</HostInstallRoot>
		<DynamoPath>$(HostInstallRoot)\AddIns\DynamoForRevit</DynamoPath>		
	</PropertyGroup>

	<PropertyGroup Condition="'$(HostProduct)' == 'Civil3D'">
		<HostInstallRoot>C:\Program Files\Autodesk\AutoCAD $(HostYear)</HostInstallRoot>
		<DynamoPath>$(HostInstallRoot)\C3D\Dynamo\Core</DynamoPath>
	</PropertyGroup>
	
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Net.Http" />
	</ItemGroup>

	<!--Dynamo references-->
	<ItemGroup>
		<Reference Include="DynamoCore">
			<HintPath>$(DynamoPath)\DynamoCore.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="DynamoCoreWpf">
			<HintPath>$(DynamoPath)\DynamoCoreWpf.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="DynamoServices">
			<HintPath>$(DynamoPath)\DynamoServices.dll</HintPath>
			<Private>false</Private>
		</Reference>
		
		<Reference Include="Microsoft.Practices.Prism">
			<HintPath>$(DynamoPath)\Microsoft.Practices.Prism.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>
      
	<ItemGroup>
	  <Resource Include="UI\Assets\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\BIMformative.Core\BIMformative.Core.csproj" />
	  <ProjectReference Include="..\BIMformative.Infrastructure\BIMformative.Infrastructure.csproj" />
	</ItemGroup>
	

	<ItemGroup>
	  <Page Update="UI\Styles\DataGrid.xaml" />
	  <Page Update="UI\Styles\Image.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </Page>
	</ItemGroup>
	
	<!--Package build output into a clean folder-->
	<Target Name="PreparePackageFolder" AfterTargets="Build">
		<MakeDir Directories="$(PackageOutputRoot)" />
		
		<ItemGroup>
			<PackageFiles Include="$(TargetDir)*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(PackageFiles)" 
			  DestinationFolder="$(PackageOutputRoot)" 
			  SkipUnchangedFiles="true" />
	</Target>
</Project>
